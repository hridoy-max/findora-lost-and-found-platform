import { useState } from 'react';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { useNavigate } from 'react-router-dom';
import { getAdminUsers, createAdminUser, updateAdminUserStatus, updateAdminUserRole, deleteAdminUser } from '../../api/admin';
import DataTable from '../../components/admin/DataTable';
import { ErrorState } from '../../components/ui/ErrorState';
import { Button } from '../../components/ui/Button';
import { Badge } from '../../components/ui/Badge';
import { Users, Shield, UserCheck, UserX, Trash2, Eye } from 'lucide-react';
import { toast } from 'sonner';
import { useListParams } from '../../hooks/useListParams';
import { ConfirmDialog } from '../../components/ui/ConfirmDialog';
import UserFormDialog from '../../components/admin/UserFormDialog';

const AdminUsersPage = () => {
  const navigate = useNavigate();
  const queryClient = useQueryClient();
  const { params, setParams } = useListParams();

  const [isUserModalOpen, setIsUserModalOpen] = useState(false);
  const [selectedUser, setSelectedUser] = useState(null);

  const { data, isLoading, isError, refetch } = useQuery({
    queryKey: ['admin-users', params],
    queryFn: () => getAdminUsers({
      page_size: 12,
      ...params
    }),
    keepPreviousData: true,
  });

  const statusMutation = useMutation({
    mutationFn: ({ userId, is_active }) => updateAdminUserStatus(userId, { is_active }),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['admin-users'] });
      toast.success('User status updated');
    },
    onError: (err) => {
      toast.error(err.response?.data?.detail || 'Failed to update status');
    },
  });

  const roleMutation = useMutation({
    mutationFn: ({ userId, role }) => updateAdminUserRole(userId, { role }),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['admin-users'] });
      toast.success('User role updated');
    },
    onError: (err) => {
      toast.error(err.response?.data?.detail || 'Failed to update role');
    },
  });

  const deleteMutation = useMutation({
    mutationFn: (userId) => deleteAdminUser(userId),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['admin-users'] });
      toast.success('User deleted');
    },
    onError: (err) => {
      toast.error(err.response?.data?.detail || 'Failed to delete user');
    },
  });

  const createUserMutation = useMutation({
    mutationFn: createAdminUser,
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['admin-users'] });
      toast.success('User created successfully');
      setIsUserModalOpen(false);
    },
    onError: (err) => {
      toast.error(err.response?.data?.detail || 'Failed to create user');
    },
  });

  const [confirmAction, setConfirmAction] = useState(null);

  const columns = [
    {
      key: 'full_name',
      label: 'User',
      render: (val, row) => (
        <div className="flex flex-col">
          <span className="font-medium text-ink">{val || 'No Name'}</span>
          <span className="text-xs text-line-600">{row.email}</span>
        </div>
      )
    },
    {
      key: 'role',
      label: 'Role',
      render: (val) => (
        <Badge variant={val === 'admin' ? 'cobalt' : 'gray'}>
          {val}
        </Badge>
      )
    },
    {
      key: 'is_active',
      label: 'Status',
      render: (val) => (
        <div className="flex items-center gap-1.5 text-xs">
          {val ? <UserCheck size={14} className="text-found" /> : <UserX size={14} className="text-danger" />}
          <span>{val ? 'Active' : 'Inactive'}</span>
        </div>
      )
    },
    {
      key: 'actions',
      label: 'Actions',
      render: (_, row) => (
        <div className="flex items-center gap-2">
          <Button
            variant="ghost"
            size="sm"
            onClick={() => navigate(`/admin/users/${row.id}`)}
            title="View Details"
          >
            <Eye size={16} />
          </Button>
          <Button
            variant="ghost"
            size="sm"
            onClick={() => setConfirmAction({ type: 'status', userId: row.id, value: !row.is_active })}
            title={row.is_active ? "Deactivate" : "Activate"}
            className={row.is_active ? "text-danger" : "text-found"}
          >
            {row.is_active ? <UserX size={16} /> : <UserCheck size={16} />}
          </Button>
          <Button
            variant="ghost"
            size="sm"
            onClick={() => setConfirmAction({ type: 'role', userId: row.id, value: row.role === 'admin' ? 'user' : 'admin' })}
            title="Toggle Role"
          >
            <Shield size={16} />
          </Button>
          <Button
            variant="ghost"
            size="sm"
            onClick={() => setConfirmAction({ type: 'delete', userId: row.id })}
            title="Delete"
            className="text-danger"
          >
            <Trash2 size={16} />
          </Button>
        </div>
      )
    }
  ];

  if (isLoading) return <div className="p-6"><DataTable columns={columns} data={[]} isLoading={true} /></div>;
  if (isError) return <ErrorState message="Could not load users" onRetry={refetch} />;

  return (
    <div className="space-y-6 p-6">
      <div className="flex justify-between items-center">
        <div>
          <h1 className="text-2xl font-bold text-ink">User Management</h1>
          <p className="text-line-600">Manage platform users, roles, and account status.</p>
        </div>
        <Button onClick={() => {
          setSelectedUser(null);
          setIsUserModalOpen(true);
        }}>
          <Users size={18} className="mr-2" />
          Create User
        </Button>
      </div>

      <DataTable
        columns={columns}
        data={data?.data || []}
        isLoading={isLoading}
        onSort={(key) => setParams({ ...params, sort_by: key })}
        currentSort={{ key: params.sort_by || 'created_at', order: params.order || 'desc' }}
      />

      {confirmAction && (
        <ConfirmDialog
          title="Confirm Action"
          description={
            confirmAction.type === 'status'
              ? `Are you sure you want to ${confirmAction.value ? 'activate' : 'deactivate'} this user?`
              : confirmAction.type === 'role'
              ? `Change user role to ${confirmAction.value}?`
              : "Are you sure you want to delete this user? This action cannot be undone."
          }
          onConfirm={() => {
            if (confirmAction.type === 'status') statusMutation.mutate({ userId: confirmAction.userId, is_active: confirmAction.value });
            if (confirmAction.type === 'role') roleMutation.mutate({ userId: confirmAction.userId, role: confirmAction.value });
            if (confirmAction.type === 'delete') deleteMutation.mutate(confirmAction.userId);
            setConfirmAction(null);
          }}
          onCancel={() => setConfirmAction(null)}
        />
      )}

      <UserFormDialog
        isOpen={isUserModalOpen}
        onClose={() => setIsUserModalOpen(false)}
        onSave={(formData) => createUserMutation.mutate(formData)}
        initialData={selectedUser}
      />
    </div>
  );
};

export default AdminUsersPage;
